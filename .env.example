# Tatum API key (Sui mainnet gateway). https://tatum.io
TATUM_API_KEY=
# Optional: override the Tatum Sui GraphQL endpoint.
# TATUM_RPC_URL=https://sui-mainnet.gateway.tatum.io/graphql

# Walrus Memory delegate key (Ed25519, hex or suiprivkey1...) and account object id.
MEMWAL_PRIVATE_KEY=
MEMWAL_ACCOUNT_ID=
# Optional: override the Walrus Memory relayer.
# MEMWAL_SERVER_URL=https://relayer.memory.walrus.xyz

# Optional: one Sui address to learn from, available as subject "wallet". More subjects go in
# data/subjects.json (`npm run cli -- subjects add <name> <address>`), each with its own
# Walrus Memory namespace shadowright-v1:<first 8 hex digits>.
# SHADOWRIGHT_WALLET=
# Optional: namespace of the "wallet" subject (default shadowright-v1, as in milestone 1).
# SHADOWRIGHT_NAMESPACE=shadowright-v1
# Optional: local data directory (default data).
# SHADOWRIGHT_DATA_DIR=data

# Optional: show only the first 4 hex digits of wallet addresses in the CLI and on the board
# (for screenshots and recordings of someone else's wallet).
# SHADOWRIGHT_MASK_ADDRESSES=1

# Optional: Licence Board address (default 127.0.0.1:8787).
# HOST=127.0.0.1
# PORT=8787
