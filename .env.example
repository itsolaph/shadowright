# Tatum API key (Sui mainnet gateway). https://tatum.io
TATUM_API_KEY=
# Optional: override the Tatum Sui RPC endpoint.
# TATUM_RPC_URL=https://sui-mainnet.gateway.tatum.io

# Walrus Memory delegate key (Ed25519, hex or suiprivkey1...) and account object id.
MEMWAL_PRIVATE_KEY=
MEMWAL_ACCOUNT_ID=
# Optional: override the Walrus Memory relayer.
# MEMWAL_SERVER_URL=https://relayer.memory.walrus.xyz

# The Sui address whose decisions Shadowright learns from.
SHADOWRIGHT_WALLET=
# Optional: Walrus Memory namespace (default shadowright-v1) and local data directory (default data).
# SHADOWRIGHT_NAMESPACE=shadowright-v1
# SHADOWRIGHT_DATA_DIR=data
